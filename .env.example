# Only the Django server reads these secrets. Never use VITE_ for an API key.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=k=#7wc^609@#-f8@bpz!7$cecs4y=uz9xzwt9mfqorb+8nlb=$
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
LLM_ENABLED=true
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
# Replace ONLY the following placeholder with your private BoxAPI key.
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_TIMEOUT=45
LLM_MAX_TOKENS=2200
LLM_JSON_MODE=false
TOROB_LIVE_ENABLED=true
TOROB_LIVE_PRODUCT_LIMIT=3
PUBLISH_PHONE_CONTACTS=true
PRICE_FRESH_DAYS=7
# Optional public React deployment -> your HTTPS Django server (no trailing /)
# VITE_API_BASE_URL=https://api.example.com

# Public WEB map key. Restrict it to localhost and your production domains.
NESHAN_MAP_KEY=
# PRIVATE service key, enable Search v3, Reverse v5 and POI Details v1.
NESHAN_SERVICE_KEY=
# PRIVATE key for actual Google search via Serper.
SERPER_API_KEY=
# Optional PRIVATE Google Places API (New) key.
GOOGLE_PLACES_API_KEY=
WEB_RESEARCH_ENABLED=true
WEB_PAGE_FETCH_ENABLED=true
RESEARCH_TIMEOUT=10

# Optional browser-restricted Maps Embed API key (server keys stay private)
GOOGLE_MAPS_BROWSER_KEY=

# Autonomous JSON tool loop (private server settings; no extra framework required)
AGENT_MAX_STEPS=6
AGENT_MAX_TOOLS=4
AGENT_DEADLINE_SECONDS=170
AGENT_MODEL_TIMEOUT=25
AGENT_STATE_TTL=1800
